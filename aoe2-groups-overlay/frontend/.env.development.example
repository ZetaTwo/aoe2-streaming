# Copy this file to .env.development (gitignored) to configure local dev.
# Vite loads .env.development automatically for `pnpm dev`.

# Option A: point at a running backend (see ../backend/README.md).
# VITE_STANDINGS_PROXY_URL="http://localhost:8080"

# Option B: skip the backend entirely and render static fixture data.
# Handy when you just want to tweak CSS/layout.
VITE_USE_MOCK_DATA="true"
